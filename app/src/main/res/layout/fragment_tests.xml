<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TestsFragment">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- כותרת ראשית -->
            <TextView
                android:id="@+id/tv_Tests_Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="26sp"
                android:textStyle="bold"
                android:paddingBottom="16dp"
                android:textColor="#1A237E"
                android:textAlignment="center"
                android:text="בדיקות והנחיות רפואיות" />

            <!-- כרטיסייה 1: הבדיקות הרלוונטיות לשבוע זה -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:backgroundTint="#E8EAF6"> <!-- רקע כחול בהיר מאוד -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvTestsHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="הבדיקות הרלוונטיות לשבוע זה"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"
                        android:textColor="#3F51B5" /> <!-- כחול ביניים -->

                    <TextView
                        android:id="@+id/tvTestsContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="#212121"
                        android:lineSpacingExtra="3dp"
                        android:text="טוען מידע על בדיקות שגרתיות..."/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- כרטיסייה 2: כיצד להבין את התוצאות -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:backgroundTint="#F3E5F5"> <!-- רקע סגול בהיר מאוד -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvResultsHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="כיצד להבין את התוצאות"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"
                        android:textColor="#9C27B0" /> <!-- סגול ביניים -->

                    <TextView
                        android:id="@+id/tvResultsContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="#212121"
                        android:lineSpacingExtra="3dp"
                        android:text="טוען מידע על פענוח תוצאות בדיקה..."/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- כרטיסייה 3: הבדיקות הבאות -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:contentPadding="12dp"
                android:backgroundTint="#E0F2F1"> <!-- רקע טורקיז בהיר -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🗓️ הבדיקות המרכזיות הבאות"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#009688"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvUpcomingTestsContent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textColor="#3E2723"
                        android:text="טוען מידע על בדיקות עתידיות..."/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
